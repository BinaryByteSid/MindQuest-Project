# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_, and it INLINES them into the
# public JavaScript bundle. Never put a secret (API key, DB URL, token) behind a
# VITE_ prefix — anyone who loads the site can read it in devtools.

# ---- Required for the AI Buddy screen ----
# ElevenLabs Conversational AI agent id. Not a secret: it identifies a public
# agent. Create one at https://elevenlabs.io/app/conversational-ai, set its
# security mode to public, and allow-list your deployed domain.
VITE_ELEVENLABS_AGENT_ID=

# ---- Optional / reserved for a future backend ----
# Nothing in src/ reads these yet.
VITE_API_URL=http://localhost:3000/api
VITE_APP_ENV=development
VITE_GOOGLE_ANALYTICS_ID=
